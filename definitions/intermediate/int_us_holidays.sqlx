config {
  type: "table",
  schema: "intermediate",
  description: "US federal public holidays from 2013 to 2024"
}

WITH holidays AS (
  SELECT date, name FROM UNNEST([
    STRUCT(DATE '2013-01-01' AS date, "New Year's Day" AS name),
    STRUCT(DATE '2013-07-04', "Independence Day"),
    STRUCT(DATE '2013-11-28', "Thanksgiving"),
    STRUCT(DATE '2013-12-25', "Christmas Day"),
    STRUCT(DATE '2014-01-01', "New Year's Day"),
    STRUCT(DATE '2014-07-04', "Independence Day"),
    STRUCT(DATE '2014-11-27', "Thanksgiving"),
    STRUCT(DATE '2014-12-25', "Christmas Day"),
    STRUCT(DATE '2015-01-01', "New Year's Day"),
    STRUCT(DATE '2015-07-04', "Independence Day"),
    STRUCT(DATE '2015-11-26', "Thanksgiving"),
    STRUCT(DATE '2015-12-25', "Christmas Day"),
    STRUCT(DATE '2016-01-01', "New Year's Day"),
    STRUCT(DATE '2016-07-04', "Independence Day"),
    STRUCT(DATE '2016-11-24', "Thanksgiving"),
    STRUCT(DATE '2016-12-25', "Christmas Day"),
    STRUCT(DATE '2017-01-01', "New Year's Day"),
    STRUCT(DATE '2017-07-04', "Independence Day"),
    STRUCT(DATE '2017-11-23', "Thanksgiving"),
    STRUCT(DATE '2017-12-25', "Christmas Day"),
    STRUCT(DATE '2018-01-01', "New Year's Day"),
    STRUCT(DATE '2018-07-04', "Independence Day"),
    STRUCT(DATE '2018-11-22', "Thanksgiving"),
    STRUCT(DATE '2018-12-25', "Christmas Day"),
    STRUCT(DATE '2019-01-01', "New Year's Day"),
    STRUCT(DATE '2019-07-04', "Independence Day"),
    STRUCT(DATE '2019-11-28', "Thanksgiving"),
    STRUCT(DATE '2019-12-25', "Christmas Day"),
    STRUCT(DATE '2020-01-01', "New Year's Day"),
    STRUCT(DATE '2020-07-04', "Independence Day"),
    STRUCT(DATE '2020-11-26', "Thanksgiving"),
    STRUCT(DATE '2020-12-25', "Christmas Day"),
    STRUCT(DATE '2021-01-01', "New Year's Day"),
    STRUCT(DATE '2021-07-04', "Independence Day"),
    STRUCT(DATE '2021-11-25', "Thanksgiving"),
    STRUCT(DATE '2021-12-25', "Christmas Day"),
    STRUCT(DATE '2022-01-01', "New Year's Day"),
    STRUCT(DATE '2022-07-04', "Independence Day"),
    STRUCT(DATE '2022-11-24', "Thanksgiving"),
    STRUCT(DATE '2022-12-25', "Christmas Day"),
    STRUCT(DATE '2023-01-01', "New Year's Day"),
    STRUCT(DATE '2023-07-04', "Independence Day"),
    STRUCT(DATE '2023-11-23', "Thanksgiving"),
    STRUCT(DATE '2023-12-25', "Christmas Day"),
    STRUCT(DATE '2024-01-01', "New Year's Day"),
    STRUCT(DATE '2024-07-04', "Independence Day"),
    STRUCT(DATE '2024-11-28', "Thanksgiving"),
    STRUCT(DATE '2024-12-25', "Christmas Day")
  ])
)

SELECT * FROM holidays
